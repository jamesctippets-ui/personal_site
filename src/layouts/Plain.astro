---
// Layout for the alternate looks (/modern, /2000, /mac). Same meta as Base.astro,
// but without the terminal's global.css, phosphor theme or VT323 font, so each
// page brings its own styles.
import { profile } from '@/data/profile';
import { withBase } from '@/utils';

interface Props {
  title?: string;
  description?: string;
  themeColor?: string;
  bodyClass?: string;
}

const { title, description = profile.tagline, themeColor = '#ffffff', bodyClass } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content={themeColor} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
  }
  img,
  svg {
    display: block;
    max-width: 100%;
  }
  button,
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
