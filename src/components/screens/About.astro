---
import { profile } from '@/data/profile';
---

<section class="frame">
  <h2 class="frame-title">ABOUT.TXT</h2>
  <p class="name">{profile.name.toUpperCase()}</p>
  <p>{profile.title} <span class="dim">·</span> {profile.location}</p>
  <hr class="rule" />
  <p class="bright">{profile.tagline}</p>
  {profile.about.map((p) => <p class="para">{p}</p>)}
  <hr class="rule" />
  <p class="try">
    <span>Try:</span>
    {
      ['projects', 'skills', 'resume', ...(profile.consulting.open ? ['consulting'] : []), 'contact'].map((c) => (
        <a class="cmd-link" href={`#${c}`} data-cmd={c}>
          {c}
        </a>
      ))
    }
  </p>
</section>

<style>
  .name {
    font-size: 2em;
    line-height: 1;
    color: var(--bright);
    letter-spacing: 0.08em;
    margin-bottom: 0.2em;
  }
  .try {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.8em;
  }
  .para {
    margin-top: 0.6em;
  }
</style>
