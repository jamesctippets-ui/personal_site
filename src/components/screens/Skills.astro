---
import { skills } from '@/data/skills';
---

<div class="grid">
  {
    skills.map((group) => (
      <section class="frame">
        <h2 class="frame-title">{group.category.toUpperCase()}</h2>
        <ul>
          {group.items.map((item) => (
            <li>
              <span class="dim" aria-hidden="true">
                &gt;{' '}
              </span>
              {item}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15em), 1fr));
    gap: 0 1em;
  }
</style>
