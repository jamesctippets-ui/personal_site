---
import { profile } from '@/data/profile';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p>&copy; {year} {profile.name}</p>
    <ul>
      {profile.email && <li><a href={`mailto:${profile.email}`}>Email</a></li>}
      {
        profile.links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-block: 2rem;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media print {
    .site-footer {
      display: none;
    }
  }
</style>
