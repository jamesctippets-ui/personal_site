---
import { profile } from '@/data/profile';
import { references } from '@/data/references';
import { withBase } from '@/utils';

const nav = [
  { label: 'About', href: withBase('#about') },
  { label: 'Projects', href: withBase('#projects') },
  { label: 'Skills', href: withBase('#skills') },
  ...(references.length ? [{ label: 'References', href: withBase('#references') }] : []),
  { label: 'Resume', href: withBase('resume') },
];
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={withBase()}>{profile.name}</a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding-block: 0.85rem;
  }
  .brand {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  nav a:hover {
    color: var(--text);
  }
  @media print {
    .site-header {
      display: none;
    }
  }
</style>
