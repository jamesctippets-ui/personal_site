---
// One window on the desktop looks (/2000, /mac). Markup only: each page skins
// it, and src/scripts/desk.ts drives it. Without JS, windows stack as a page.
import Glyph from '@/components/plain/Glyph.astro';
import type { GlyphName } from '@/components/plain/sections';

interface Props {
  id: string;
  title: string;
  short?: string;
  glyph: GlyphName;
  width?: number;
  height?: number;
}
const { id, title, short, glyph, width = 560, height } = Astro.props;
---

<section
  id={id}
  class="win"
  data-window={id}
  data-title={title}
  data-short={short}
  data-width={width}
  data-height={height}
  role="dialog"
  aria-labelledby={`${id}-title`}
>
  <header class="titlebar" data-drag-handle>
    <div class="controls">
      <button type="button" class="ctl ctl-close" data-action="close" aria-label={`Close ${title}`}></button>
      <button type="button" class="ctl ctl-min" data-action="minimize" aria-label={`Minimize ${title}`}></button>
      <button type="button" class="ctl ctl-max" data-action="maximize" aria-label={`Maximize ${title}`}></button>
    </div>
    <Glyph name={glyph} size={16} />
    <h2 id={`${id}-title`}>{title}</h2>
  </header>
  <div class="win-body">
    <slot />
  </div>
</section>
