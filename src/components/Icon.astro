---
// Original pixel-style icons drawn on a 32x32 grid. Add new ones to `icons`.
export type IconName =
  | 'about'
  | 'projects'
  | 'skills'
  | 'references'
  | 'resume'
  | 'globe'
  | 'mail'
  | 'power'
  | 'computer'
  | 'warning';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 32, class: className } = Astro.props;

const icons: Record<IconName, string> = {
  // ID card with a person
  about: `
    <rect x="2" y="6" width="28" height="20" fill="#fff8d8" stroke="#0a0a0a" stroke-width="2"/>
    <rect x="3" y="7" width="26" height="4" fill="#0b2a8a"/>
    <rect x="6" y="13" width="8" height="10" fill="#9fc4ef" stroke="#0a0a0a"/>
    <rect x="8" y="14" width="4" height="4" fill="#e0a070"/>
    <rect x="7" y="18" width="6" height="5" fill="#b03030"/>
    <rect x="16" y="14" width="10" height="2" fill="#0a0a0a"/>
    <rect x="16" y="18" width="8" height="2" fill="#808080"/>
    <rect x="16" y="21" width="9" height="2" fill="#808080"/>`,
  // Folder
  projects: `
    <path d="M2 8h10l3 3h15v17H2z" fill="#e8c34a" stroke="#0a0a0a" stroke-width="2"/>
    <path d="M3 13h26v14H3z" fill="#f6dc7a"/>
    <path d="M3 13h26" stroke="#fff3b8" stroke-width="2"/>`,
  // Toolbox
  skills: `
    <path d="M11 10V6h10v4" fill="none" stroke="#0a0a0a" stroke-width="2"/>
    <rect x="3" y="10" width="26" height="17" fill="#c8402c" stroke="#0a0a0a" stroke-width="2"/>
    <rect x="4" y="11" width="24" height="3" fill="#e8705a"/>
    <rect x="4" y="17" width="24" height="2" fill="#7a2014"/>
    <rect x="14" y="16" width="4" height="4" fill="#d8d8d8" stroke="#0a0a0a"/>`,
  // Speech bubbles
  references: `
    <path d="M3 4h18v12H10l-5 4v-4H3z" fill="#fff" stroke="#0a0a0a" stroke-width="2"/>
    <path d="M12 13h17v11h-2v4l-5-4H12z" fill="#9fc4ef" stroke="#0a0a0a" stroke-width="2"/>
    <rect x="6" y="8" width="11" height="2" fill="#808080"/>
    <rect x="15" y="17" width="10" height="2" fill="#0b2a8a"/>`,
  // Document with folded corner
  resume: `
    <path d="M6 2h14l7 7v21H6z" fill="#fff" stroke="#0a0a0a" stroke-width="2"/>
    <path d="M20 2v7h7" fill="#d8d8d8" stroke="#0a0a0a" stroke-width="2"/>
    <rect x="9" y="8" width="8" height="2" fill="#0b2a8a"/>
    <rect x="9" y="13" width="15" height="2" fill="#808080"/>
    <rect x="9" y="17" width="15" height="2" fill="#808080"/>
    <rect x="9" y="21" width="15" height="2" fill="#808080"/>
    <rect x="9" y="25" width="10" height="2" fill="#808080"/>`,
  // Globe
  globe: `
    <circle cx="16" cy="16" r="13" fill="#4a90d9" stroke="#0a0a0a" stroke-width="2"/>
    <path d="M9 8h6v4h-3v4H7v-3zM18 17h7v5l-4 4h-3z" fill="#3fa34d"/>
    <path d="M3 16h26M16 3c-6 7-6 19 0 26M16 3c6 7 6 19 0 26" fill="none" stroke="#0a0a0a" stroke-opacity=".45"/>`,
  // Envelope
  mail: `
    <rect x="3" y="7" width="26" height="18" fill="#fff" stroke="#0a0a0a" stroke-width="2"/>
    <path d="M4 8l12 10 12-10" fill="none" stroke="#0a0a0a" stroke-width="2"/>
    <rect x="22" y="10" width="4" height="4" fill="#c8402c"/>`,
  // Power symbol
  power: `
    <circle cx="16" cy="16" r="13" fill="#c8402c" stroke="#0a0a0a" stroke-width="2"/>
    <path d="M11 11a8 8 0 1 0 10 0" fill="none" stroke="#fff" stroke-width="3"/>
    <path d="M16 7v9" stroke="#fff" stroke-width="3"/>`,
  // Beige computer (start button / home)
  computer: `
    <rect x="4" y="3" width="24" height="18" fill="#d8d0b8" stroke="#0a0a0a" stroke-width="2"/>
    <rect x="7" y="6" width="18" height="12" fill="#0f7b7b" stroke="#0a0a0a"/>
    <rect x="9" y="8" width="6" height="2" fill="#9fe8e0"/>
    <rect x="12" y="21" width="8" height="3" fill="#a89f88" stroke="#0a0a0a"/>
    <rect x="6" y="24" width="20" height="5" fill="#d8d0b8" stroke="#0a0a0a" stroke-width="2"/>
    <rect x="20" y="26" width="3" height="1" fill="#3fa34d"/>`,
  // Warning triangle
  warning: `
    <path d="M16 3l14 25H2z" fill="#f6d040" stroke="#0a0a0a" stroke-width="2" stroke-linejoin="round"/>
    <rect x="14.5" y="11" width="3" height="9" fill="#0a0a0a"/>
    <rect x="14.5" y="22" width="3" height="3" fill="#0a0a0a"/>`,
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
  shape-rendering="crispEdges"
  set:html={icons[name]}
/>
