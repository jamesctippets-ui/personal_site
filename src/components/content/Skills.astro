---
import { skills } from '@/data/skills';
---

<div class="grid">
  {
    skills.map((group) => (
      <fieldset class="groupbox">
        <legend>{group.category}</legend>
        <ul>
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </fieldset>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: 0 1rem;
  }
  .groupbox {
    background: var(--face);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 1px 0;
  }
  li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--select);
  }
</style>
