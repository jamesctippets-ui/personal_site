---
import { references } from '@/data/references';
---

<div class="list">
  {
    references.map((ref) => (
      <figure>
        <blockquote class="sunken">
          <p>“{ref.quote}”</p>
        </blockquote>
        <figcaption>
          <strong>
            {ref.url ? (
              <a href={ref.url} target="_blank" rel="noopener">
                {ref.name}
              </a>
            ) : (
              ref.name
            )}
          </strong>
          , {ref.role}
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  figure {
    margin: 0;
  }
  blockquote {
    margin: 0 0 0.35rem;
    padding: 0.75rem 0.9rem;
    background: #ffffe1;
    font-family: 'Courier New', Courier, monospace;
    font-size: 14px;
  }
  blockquote p {
    margin: 0;
  }
  figcaption {
    font-size: 13px;
    padding-left: 0.25rem;
  }
</style>
