---
import Icon from '@/components/Icon.astro';
import { projects } from '@/data/projects';

// Featured projects first, otherwise keep the order from projects.ts.
const sorted = [...projects].sort(
  (a, b) => Number(b.featured ?? false) - Number(a.featured ?? false),
);
const statusLabel = { active: 'In progress', complete: 'Complete', paused: 'Paused' };
---

<ul class="list">
  {
    sorted.map((project) => (
      <li>
        <fieldset class="groupbox">
          <legend>
            {project.featured && <span class="star" title="Featured">★</span>}
            {project.name}
          </legend>
          <div class="row">
            <Icon name="projects" size={32} />
            <div class="info">
              <p class="status">
                Status: <span class:list={['pill', project.status]}>{statusLabel[project.status]}</span>
              </p>
              <p>{project.summary}</p>
              <ul class="tags" aria-label="Technologies">
                {project.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
              {(project.url || project.repo) && (
                <div class="links">
                  {project.url && (
                    <a class="btn" href={project.url} target="_blank" rel="noopener">
                      Visit site
                    </a>
                  )}
                  {project.repo && (
                    <a class="btn" href={project.repo} target="_blank" rel="noopener">
                      View source
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </fieldset>
      </li>
    ))
  }
</ul>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .groupbox {
    background: var(--face);
  }
  .star {
    color: #b8860b;
    margin-right: 0.25rem;
  }
  .row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .info {
    flex: 1;
    min-width: 0;
  }
  .status {
    margin-bottom: 0.4rem;
    font-size: 12px;
  }
  .pill {
    font-weight: 700;
  }
  .pill.active {
    color: #006400;
  }
  .pill.paused {
    color: #8a5a00;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
</style>
