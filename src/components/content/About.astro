---
import Icon from '@/components/Icon.astro';
import { profile } from '@/data/profile';
---

<div class="about">
  <div class="id">
    <Icon name="about" size={64} />
    <div>
      <h3>{profile.name}</h3>
      <p class="title">{profile.title}</p>
      <p class="loc">{profile.location}</p>
    </div>
  </div>
  <p class="tagline">{profile.tagline}</p>
  {profile.about.map((p) => <p>{p}</p>)}
  <div class="links">
    {
      profile.email && (
        <a class="btn" href={`mailto:${profile.email}`}>
          <Icon name="mail" size={16} /> Email
        </a>
      )
    }
    {
      profile.links.map((link) => (
        <a class="btn" href={link.href} rel="me noopener" target="_blank">
          <Icon name="globe" size={16} /> {link.label}
        </a>
      ))
    }
  </div>
  <p class="tip js-only">
    Tip: open the other windows from the icons on the desktop or from the Start menu.
  </p>
</div>

<style>
  .id {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  h3 {
    font-size: 20px;
  }
  .title {
    margin: 0.15rem 0 0;
    font-weight: 700;
    color: var(--muted);
  }
  .loc {
    margin: 0;
    color: var(--muted);
  }
  .tagline {
    font-size: 15px;
    font-weight: 700;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
  }
  .tip {
    margin: 0;
    padding: 0.5rem 0.6rem;
    background: #ffffe1;
    border: 1px solid var(--text);
    font-size: 12px;
  }
  :global(html:not(.js)) .js-only {
    display: none;
  }
</style>
