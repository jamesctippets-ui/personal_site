---
import Icon, { type IconName } from '@/components/Icon.astro';

interface Props {
  /** Used as the element id and the URL hash (#id) that opens this window. */
  id: string;
  title: string;
  icon: IconName;
  /** Preferred width in px on desktop; clamped to the viewport by the script. */
  width?: number;
  /** Preferred height in px on desktop; omitted = fit content up to the viewport. */
  height?: number;
  /** Text shown in the status bar along the bottom edge. */
  status?: string;
  /** 'field' = white document area; 'face' = grey dialog area (for group boxes). */
  surface?: 'field' | 'face';
}

const { id, title, icon, width = 560, height, status, surface = 'field' } = Astro.props;
const titleId = `${id}-title`;
---

<section
  id={id}
  class="window raised"
  data-window={id}
  data-title={title}
  data-icon={icon}
  data-width={width}
  data-height={height}
  role="dialog"
  aria-labelledby={titleId}
>
  <header class="titlebar" data-drag-handle>
    <Icon name={icon} size={16} />
    <h2 id={titleId}>{title}</h2>
    <div class="controls">
      <button type="button" class="ctl" data-action="minimize" aria-label={`Minimize ${title}`}>
        <span aria-hidden="true" class="glyph-min"></span>
      </button>
      <button type="button" class="ctl" data-action="maximize" aria-label={`Maximize ${title}`}>
        <span aria-hidden="true" class="glyph-max"></span>
      </button>
      <button type="button" class="ctl ctl-close" data-action="close" aria-label={`Close ${title}`}>
        <span aria-hidden="true" class="glyph-close"></span>
      </button>
    </div>
  </header>
  <slot name="toolbar" />
  <div class:list={['window-body', 'sunken', { 'is-face': surface === 'face' }]}>
    <slot />
  </div>
  {status && <footer class="statusbar">{status}</footer>}
</section>

<style>
  .window {
    display: flex;
    flex-direction: column;
    padding: 3px;
    max-width: 100%;
    /* No-JS / fallback layout: windows stack down the page. */
    margin: 0 auto 1.25rem;
    width: min(100%, 46rem);
  }

  /* With JavaScript, windows float on the desktop and start closed. */
  :global(html.js) .window {
    display: none;
    position: absolute;
    margin: 0;
    min-width: 16rem;
    min-height: 8rem;
  }
  :global(html.js) .window.is-open {
    display: flex;
  }
  :global(html.js) .window.is-maximized {
    inset: 0 !important;
    width: auto !important;
    height: auto !important;
    max-height: none !important;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 2px 2px 2px 4px;
    background: linear-gradient(90deg, var(--title-inactive-a), var(--title-inactive-b));
    color: var(--face-light);
    user-select: none;
    touch-action: none;
  }
  :global(html.js) .titlebar {
    cursor: default;
  }
  :global(.window.is-active) .titlebar,
  :global(html:not(.js)) .titlebar {
    background: linear-gradient(90deg, var(--title-a), var(--title-b));
    color: #fff;
  }
  h2 {
    flex: 1;
    min-width: 0;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .controls {
    display: flex;
    gap: 2px;
  }
  :global(html:not(.js)) .controls {
    display: none;
  }
  .ctl {
    position: relative;
    width: 18px;
    height: 16px;
    padding: 0;
    border: 0;
    background: var(--face);
    box-shadow: var(--raised);
    cursor: pointer;
  }
  .ctl:active {
    box-shadow: var(--pressed);
  }
  .ctl-close {
    margin-left: 2px;
  }
  .glyph-min,
  .glyph-max,
  .glyph-close {
    position: absolute;
    inset: 0;
    margin: auto;
  }
  .glyph-min {
    width: 7px;
    height: 2px;
    top: 7px;
    background: var(--text);
  }
  .glyph-max {
    width: 9px;
    height: 8px;
    border: 1px solid var(--text);
    border-top-width: 2px;
  }
  .glyph-close::before,
  .glyph-close::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 2px;
    background: var(--text);
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .glyph-close::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .window-body {
    flex: 1;
    min-height: 0;
    margin-top: 3px;
    padding: 1rem 1.1rem;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .window-body.is-face {
    background: var(--face);
  }
  /* Phones: windows are always full-screen, so maximize does nothing. */
  @media (max-width: 720px) {
    .ctl[data-action='maximize'] {
      display: none;
    }
  }

  .statusbar {
    margin-top: 2px;
    padding: 1px 6px;
    font-size: 12px;
    color: var(--muted);
    box-shadow: inset -1px -1px var(--3d-hi), inset 1px 1px var(--3d-shadow);
  }
</style>
