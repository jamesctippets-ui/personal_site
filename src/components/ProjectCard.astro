---
import type { Project } from '@/data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const statusLabel = { active: 'In progress', complete: 'Complete', paused: 'Paused' }[project.status];
---

<article class:list={['card', { featured: project.featured }]}>
  <div class="top">
    <h3>{project.name}</h3>
    <span class:list={['status', project.status]}>{statusLabel}</span>
  </div>
  <p>{project.summary}</p>
  <ul class="tags" aria-label="Technologies">
    {project.tags.map((tag) => <li class="tag">{tag}</li>)}
  </ul>
  {
    (project.url || project.repo) && (
      <div class="links">
        {project.url && <a href={project.url}>Live site</a>}
        {project.repo && <a href={project.repo}>Source</a>}
      </div>
    )
  }
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .featured {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  h3 {
    font-size: 1.125rem;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
  .status {
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--muted);
  }
  .status.active {
    color: #1e8a4c;
  }
  @media (prefers-color-scheme: dark) {
    .status.active {
      color: #5fcf8e;
    }
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    font-size: 0.9375rem;
    font-weight: 500;
  }
</style>
