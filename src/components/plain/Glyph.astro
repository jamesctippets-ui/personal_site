---
// Small original icon set for the desktop looks (/2000 and /mac). Flat,
// multi-color shapes on a 32x32 grid. Decorative: always aria-hidden.
import type { GlyphName } from '@/components/plain/sections';

interface Props {
  name: GlyphName;
  size?: number;
}
const { name, size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="glyph">
  {
    name === 'about' && (
      <>
        <circle cx="16" cy="11" r="6" fill="#f3c38f" stroke="#7a4b1f" />
        <path d="M5 29c1-7 5-10 11-10s10 3 11 10z" fill="#3c7be0" stroke="#1d3f7a" />
      </>
    )
  }
  {
    name === 'experience' && (
      <>
        <rect x="4" y="10" width="24" height="17" rx="2" fill="#a8672a" stroke="#5c3510" />
        <path d="M12 10V7h8v3" fill="none" stroke="#5c3510" stroke-width="2" />
        <rect x="4" y="15" width="24" height="3" fill="#7d4a18" />
      </>
    )
  }
  {
    name === 'resume' && (
      <>
        <path d="M7 3h13l6 6v20H7z" fill="#fff" stroke="#556" />
        <path d="M20 3v6h6" fill="#dde" stroke="#556" />
        <path d="M10 13h12M10 17h12M10 21h9M10 25h11" stroke="#3c7be0" stroke-width="1.6" />
      </>
    )
  }
  {
    name === 'projects' && (
      <>
        <path d="M3 8h10l3 3h13v16H3z" fill="#f5c542" stroke="#9a7212" />
        <path d="M3 13h26v14H3z" fill="#ffd95e" stroke="#9a7212" />
      </>
    )
  }
  {
    name === 'skills' && (
      <>
        <rect x="8" y="8" width="16" height="16" rx="2" fill="#2f8f5b" stroke="#145234" />
        <path d="M11 4v4M16 4v4M21 4v4M11 24v4M16 24v4M21 24v4M4 11h4M4 16h4M4 21h4M24 11h4M24 16h4M24 21h4" stroke="#8a8f99" stroke-width="2" />
        <rect x="12" y="12" width="8" height="8" fill="#b8f0cf" />
      </>
    )
  }
  {
    name === 'lab' && (
      <>
        <rect x="6" y="3" width="20" height="8" rx="1" fill="#4a5568" stroke="#1f2733" />
        <rect x="6" y="12" width="20" height="8" rx="1" fill="#4a5568" stroke="#1f2733" />
        <rect x="6" y="21" width="20" height="8" rx="1" fill="#4a5568" stroke="#1f2733" />
        <circle cx="10" cy="7" r="1.4" fill="#5cf08a" />
        <circle cx="10" cy="16" r="1.4" fill="#5cf08a" />
        <circle cx="10" cy="25" r="1.4" fill="#f0c05c" />
        <path d="M15 7h8M15 16h8M15 25h8" stroke="#a0aec0" />
      </>
    )
  }
  {
    name === 'museum' && (
      <>
        <path d="M3 11L16 4l13 7z" fill="#d9c7a3" stroke="#6b5a3a" />
        <path d="M7 12v12M12.5 12v12M19.5 12v12M25 12v12" stroke="#e8dcc2" stroke-width="3" />
        <path d="M7 12v12M12.5 12v12M19.5 12v12M25 12v12" stroke="#6b5a3a" stroke-width="0.6" />
        <rect x="3" y="24" width="26" height="4" fill="#d9c7a3" stroke="#6b5a3a" />
      </>
    )
  }
  {
    name === 'consulting' && (
      <>
        <path d="M6 18l6-6 4 3 4-3 6 6-10 9z" fill="#f3c38f" stroke="#7a4b1f" />
        <path d="M3 15l5-5 5 5-5 5zM19 15l5-5 5 5-5 5z" fill="#3c7be0" stroke="#1d3f7a" />
      </>
    )
  }
  {
    name === 'contact' && (
      <>
        <rect x="3" y="7" width="26" height="18" rx="2" fill="#fff" stroke="#556" />
        <path d="M3 8l13 10L29 8" fill="none" stroke="#d24b3c" stroke-width="2" />
      </>
    )
  }
  {
    name === 'terminal' && (
      <>
        <rect x="2" y="4" width="28" height="24" rx="3" fill="#0b130b" stroke="#3a4a3a" />
        <path d="M7 11l6 5-6 5" fill="none" stroke="#3dff6e" stroke-width="2.4" />
        <path d="M15 22h9" stroke="#3dff6e" stroke-width="2.4" />
      </>
    )
  }
  {
    name === 'globe' && (
      <>
        <circle cx="16" cy="16" r="12" fill="#5aa9f0" stroke="#1d4f7a" />
        <path d="M9 10c4 1 4 5 8 5s2 6 6 7M7 19c3 0 4 3 4 6M18 5c0 3 4 3 6 4" fill="none" stroke="#2f8f5b" stroke-width="3" stroke-linecap="round" />
      </>
    )
  }
</svg>
