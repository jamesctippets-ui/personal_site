---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { withBase } from '@/utils';
---

<Base title="Page not found">
  <div class="wrap">
    <div class="dialog raised" role="alertdialog" aria-labelledby="nf-title" aria-describedby="nf-desc">
      <header class="titlebar">
        <h1 id="nf-title">Error</h1>
      </header>
      <div class="body">
        <Icon name="warning" size={32} />
        <p id="nf-desc">
          The page you're looking for could not be found. It may have been moved, renamed, or never
          existed.
        </p>
      </div>
      <div class="actions">
        <a class="btn" href={withBase()}>OK</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .wrap {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  .dialog {
    width: min(100%, 26rem);
    padding: 3px;
  }
  .titlebar {
    padding: 3px 6px;
    background: linear-gradient(90deg, var(--title-a), var(--title-b));
    color: #fff;
  }
  h1 {
    font-size: 13px;
  }
  .body {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 1rem 0.5rem;
  }
  .body p {
    margin: 0;
  }
  .actions {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0 0.9rem;
  }
</style>
