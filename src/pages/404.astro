---
import Base from '@/layouts/Base.astro';
import { withBase } from '@/utils';
---

<Base title="Page not found">
  <section class="container nf">
    <h1>Page not found</h1>
    <p>That page doesn't exist or has moved.</p>
    <a class="btn" href={withBase()}>Back to home</a>
  </section>
</Base>

<style>
  .nf {
    padding-block: 6rem;
    text-align: center;
  }
  h1 {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }
  p {
    color: var(--muted);
    margin: 0 0 2rem;
  }
</style>
