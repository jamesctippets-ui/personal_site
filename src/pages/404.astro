---
import Base from '@/layouts/Base.astro';
import { withBase } from '@/utils';
---

<Base title="File not found">
  <main class="nf">
    <p><span class="p">C:\JAMES&gt;</span>type {'<this page>'}</p>
    <p class="bright">File not found.</p>
    <p class="dim">The page you asked for doesn't exist or has moved.</p>
    <p><a href={withBase()}>[ Return to JamesOS ]</a></p>
  </main>
</Base>

<style>
  .nf {
    padding: 2rem 1rem;
    max-width: 40rem;
  }
  p + p {
    margin-top: 0.5em;
  }
  .p {
    color: var(--dim);
  }
</style>
