---
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { profile } from '@/data/profile';
import { projects } from '@/data/projects';
import { skills } from '@/data/skills';
import { references } from '@/data/references';
import { withBase } from '@/utils';

// Featured projects first, otherwise keep the order from projects.ts.
const sortedProjects = [...projects].sort(
  (a, b) => Number(b.featured ?? false) - Number(a.featured ?? false),
);
---

<Base>
  <section class="hero container">
    <p class="eyebrow">{profile.title} · {profile.location}</p>
    <h1>Hi, I'm {profile.name.split(' ')[0]}.</h1>
    <p class="tagline">{profile.tagline}</p>
    <div class="actions">
      <a class="btn" href={withBase('resume')}>View resume</a>
      {
        profile.email ? (
          <a class="btn btn-secondary" href={`mailto:${profile.email}`}>
            Get in touch
          </a>
        ) : (
          <a class="btn btn-secondary" href="#projects">
            See projects
          </a>
        )
      }
    </div>
  </section>

  <section id="about" class="section">
    <div class="container">
      <h2 class="section-title">About</h2>
      {profile.about.map((p) => <p class="lead">{p}</p>)}
    </div>
  </section>

  <section id="projects" class="section">
    <div class="container">
      <h2 class="section-title">Projects</h2>
      <div class="grid">
        {sortedProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section id="skills" class="section">
    <div class="container">
      <h2 class="section-title">Skills</h2>
      <div class="skills">
        {
          skills.map((group) => (
            <div>
              <h3>{group.category}</h3>
              <ul>
                {group.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    references.length > 0 && (
      <section id="references" class="section">
        <div class="container">
          <h2 class="section-title">References</h2>
          <div class="grid">
            {references.map((ref) => (
              <figure class="quote">
                <blockquote>
                  <p>“{ref.quote}”</p>
                </blockquote>
                <figcaption>
                  <strong>{ref.url ? <a href={ref.url}>{ref.name}</a> : ref.name}</strong>
                  <span>{ref.role}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: 5rem 4rem;
  }
  .eyebrow {
    color: var(--muted);
    font-weight: 500;
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin-bottom: 1rem;
  }
  .tagline {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--muted);
    max-width: 40rem;
    margin: 0 0 2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .lead {
    font-size: 1.125rem;
    max-width: 46rem;
    margin: 0 0 1rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 2rem;
  }
  .skills h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }
  .skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .quote {
    margin: 0;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    margin: 0;
    font-size: 1.0625rem;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    font-size: 0.9375rem;
    margin-top: auto;
  }
  figcaption span {
    color: var(--muted);
  }
</style>
