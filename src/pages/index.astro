---
import Base from '@/layouts/Base.astro';
import Help from '@/components/screens/Help.astro';
import About from '@/components/screens/About.astro';
import Projects from '@/components/screens/Projects.astro';
import Skills from '@/components/screens/Skills.astro';
import ResumeText from '@/components/screens/ResumeText.astro';
import Consulting from '@/components/screens/Consulting.astro';
import Contact from '@/components/screens/Contact.astro';
import References from '@/components/screens/References.astro';
import { profile } from '@/data/profile';
import { references } from '@/data/references';

// Menu bar entries. `cmd` must be a screen command from src/scripts/commands.ts.
const menu = [
  { label: 'About', cmd: 'about' },
  { label: 'Projects', cmd: 'projects' },
  { label: 'Skills', cmd: 'skills' },
  { label: 'Resume', cmd: 'resume' },
  ...(profile.consulting.open ? [{ label: 'Hire me', cmd: 'consulting' }] : []),
  { label: 'Contact', cmd: 'contact' },
  { label: 'Help', cmd: 'help' },
];

// F-key bar. Keys match the FKEYS map in terminal.ts (F5 is left to the browser).
const fkeys = [
  { key: 'F1', label: 'Help', cmd: 'help' },
  { key: 'F2', label: 'About', cmd: 'about' },
  { key: 'F3', label: 'Projects', cmd: 'projects' },
  { key: 'F4', label: 'Skills', cmd: 'skills' },
  { key: 'F6', label: 'Resume', cmd: 'resume' },
  { key: 'F7', label: 'Contact', cmd: 'contact' },
  { key: '', label: 'Color', cmd: 'color' },
  { key: '', label: 'Exit', cmd: 'exit' },
];

// Screens in no-JS reading order. Each becomes a <section data-screen> that the
// terminal clones when its command runs.
const screens = [
  { id: 'about', file: 'about.txt' },
  { id: 'projects', file: 'projects' },
  { id: 'skills', file: 'skills.txt' },
  { id: 'resume', file: 'resume.doc' },
  ...(profile.consulting.open ? [{ id: 'consulting', file: 'hire_me.txt' }] : []),
  ...(references.length ? [{ id: 'references', file: 'refs.txt' }] : []),
  { id: 'contact', file: 'contact.txt' },
  { id: 'help', file: 'help.txt' },
];
---

<Base>
  <div class="crt">
    <header class="menubar">
      <span class="brand inv">JamesOS</span>
      <nav aria-label="Sections">
        <ul>
          {
            menu.map((m) => (
              <li>
                <a href={`#${m.cmd}`} data-cmd={m.cmd}>
                  {m.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <span id="clock" class="clock dim" aria-hidden="true"></span>
    </header>

    <main id="output" class="output" role="log" aria-live="polite" aria-label="Terminal output">
      <h1 class="sr-only">{profile.name}, {profile.title}</h1>
      <div id="screens">
        {
          screens.map((s) => (
            <section id={s.id} data-screen={s.id} class="screen">
              <p class="static-echo">
                <span class="p">C:\JAMES&gt;</span>type {s.file}
              </p>
              {s.id === 'about' && <About />}
              {s.id === 'projects' && <Projects />}
              {s.id === 'skills' && <Skills />}
              {s.id === 'resume' && <ResumeText />}
              {s.id === 'consulting' && <Consulting />}
              {s.id === 'references' && <References />}
              {s.id === 'contact' && <Contact />}
              {s.id === 'help' && <Help />}
            </section>
          ))
        }
      </div>
    </main>

    <form id="prompt" class="prompt" autocomplete="off">
      <label for="cmd" class="p">C:\JAMES&gt;</label>
      <input
        id="cmd"
        name="cmd"
        type="text"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="go"
        aria-label="Command"
        placeholder="type help"
      />
      <button type="submit" class="enter">Enter</button>
    </form>

    <footer class="fkeys">
      <ul>
        {
          fkeys.map((f) => (
            <li>
              <button type="button" data-cmd={f.cmd}>
                {f.key && <span class="key">{f.key}</span>}
                <span>{f.label}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </footer>

    <div id="halt" class="halt" hidden>
      <p>JamesOS has halted.</p>
      <p class="dim">Thanks for visiting. Press any key or tap to restart.</p>
    </div>
  </div>
</Base>

<script>
  import '@/scripts/terminal';
</script>

<style>
  /* ---------- Shared ---------- */
  .crt {
    position: relative;
    min-height: 100vh;
  }
  /* Faint scanlines over everything; purely decorative. */
  .crt::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.18) 0,
      rgba(0, 0, 0, 0.18) 1px,
      transparent 1px,
      transparent 3px
    );
    z-index: 50;
  }

  .menubar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2em 1em;
    padding: 0.35em 0.75em;
    border-bottom: 3px double var(--fg);
  }
  .brand {
    letter-spacing: 0.05em;
  }
  .menubar ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9em;
    flex: 1;
  }
  .menubar a {
    color: var(--fg);
    text-decoration: none;
    padding: 0 0.2em;
  }
  .menubar a::first-letter {
    text-decoration: underline;
  }
  .menubar a:hover,
  .menubar a:focus-visible {
    background: var(--fg);
    color: var(--bg);
  }

  .output {
    padding: 0.75em 1em 1.5em;
  }
  .output :global(.echo),
  .static-echo {
    margin-top: 1em;
    color: var(--dim);
  }
  .output :global(.p) {
    color: var(--fg);
  }
  .output :global(.dir) {
    margin: 0.3em 0;
  }
  .output :global(.dir div) {
    display: flex;
    gap: 1em;
  }
  .output :global(.dir .cmd-link) {
    width: 9em;
  }
  .output :global(.block) {
    max-width: 62em;
  }
  .screen {
    max-width: 62em;
  }

  /* ---------- No JS: a plain scrolling page ---------- */
  .prompt,
  .fkeys {
    display: none;
  }

  /* ---------- Terminal mode (JS) ---------- */
  :global(html.js) .crt {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    min-height: 0;
  }
  :global(html.js) .output {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  :global(html.js) #screens {
    display: none;
  }

  :global(html.js) .prompt {
    display: flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.3em 1em;
    border-top: 1px dashed var(--dim);
  }
  .prompt input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--bright);
    font: inherit;
    text-shadow: inherit;
    caret-color: var(--fg);
    padding: 0.15em 0;
    /* iOS zooms into inputs under 16px; --size is always above that. */
  }
  .prompt input::placeholder {
    color: var(--dim);
    opacity: 0.7;
  }
  .prompt input:focus::placeholder {
    color: transparent;
  }
  .enter {
    border: 1px solid var(--fg);
    background: transparent;
    padding: 0 0.6em;
    cursor: pointer;
  }
  .enter:hover,
  .enter:focus-visible {
    background: var(--fg);
    color: var(--bg);
    outline: none;
  }

  :global(html.js) .fkeys {
    display: block;
    padding: 0.25em 0.75em calc(0.3em + env(safe-area-inset-bottom));
    border-top: 3px double var(--fg);
  }
  .fkeys ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em 0.9em;
  }
  .fkeys button {
    display: inline-flex;
    gap: 0.25em;
    border: 0;
    background: none;
    padding: 0 0.15em;
    cursor: pointer;
  }
  .fkeys .key {
    color: var(--bg);
    background: var(--dim);
    text-shadow: none;
    padding: 0 0.2em;
  }
  .fkeys button:hover,
  .fkeys button:focus-visible {
    background: var(--fg);
    color: var(--bg);
    outline: none;
  }

  /* ---------- Halt screen ---------- */
  .halt:not([hidden]) {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    padding: 1em;
    background: var(--bg);
    text-align: center;
    font-size: 1.3em;
    cursor: pointer;
  }

  /* ---------- Phones ---------- */
  @media (max-width: 640px) {
    .clock {
      display: none;
    }
    .output {
      padding: 0.5em 0.75em 1em;
    }
    /* The menu bar already covers navigation; the F-key bar would just eat screen. */
    :global(html.js) .fkeys {
      display: none;
    }
    :global(html.js) .prompt {
      padding-bottom: calc(0.3em + env(safe-area-inset-bottom));
    }
  }
  @media (hover: none) {
    .fkeys .key {
      display: none;
    }
  }
</style>
