---
// The "modern" look: a clean, conventional one-page site for visitors who
// would rather not use the terminal. Same data as every other look.
import Plain from '@/layouts/Plain.astro';
import Content from '@/components/plain/Content.astro';
import LookSwitcher from '@/components/plain/LookSwitcher.astro';
import { sections } from '@/components/plain/sections';
import { profile } from '@/data/profile';
import { withBase } from '@/utils';

const linkedin = profile.links.find((l) => l.label === 'LinkedIn');
const contactTarget = profile.consulting.open ? 'consulting' : 'contact';
---

<Plain title="Modern view" themeColor="#0f6fde" bodyClass="modern">
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href="#top">{profile.name}</a>
      <nav aria-label="Sections" class="nav">
        <ul>
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`}>{s.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="term-link" href={withBase('')} title="Back to the retro terminal version">
        <span aria-hidden="true">&gt;_</span> Terminal
      </a>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="wrap">
        <p class="eyebrow">{profile.location}</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.title}</p>
        <p class="tagline">{profile.tagline}</p>
        <div class="cta">
          <a class="pc-btn pc-primary" href={`#${contactTarget}`}>Get in touch</a>
          <a class="pc-btn" href={withBase('resume/')}>View resume</a>
          {linkedin && <a class="pc-btn" href={linkedin.href} target="_blank" rel="me noopener">LinkedIn</a>}
        </div>
      </div>
    </section>

    {
      sections.map((s, i) => (
        <section id={s.id} class:list={['band', { alt: i % 2 === 0 }]} aria-labelledby={`${s.id}-h`}>
          <div class="wrap">
            <h2 id={`${s.id}-h`}>{s.title}</h2>
            <Content section={s.id} />
          </div>
        </section>
      ))
    }
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <p>© {new Date().getFullYear()} {profile.name}</p>
      <LookSwitcher current="modern" />
    </div>
  </footer>
</Plain>

<script>
  import '@/scripts/inquiry';
</script>

<style is:global>
  body.modern {
    --bg: #ffffff;
    --bg-alt: #f4f6fa;
    --text: #18202b;
    --muted: #5b6676;
    --line: #e1e6ee;
    --accent: #0f6fde;
    --accent-ink: #ffffff;
    --accent-soft: #e6f0fd;
    --card: #ffffff;
    background: var(--bg);
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  @media (prefers-color-scheme: dark) {
    body.modern {
      --bg: #0e131b;
      --bg-alt: #131a24;
      --text: #e7ecf3;
      --muted: #9aa6b6;
      --line: #263142;
      --accent: #5aa2ff;
      --accent-ink: #08111e;
      --accent-soft: #17283f;
      --card: #172030;
    }
  }
  .modern a {
    color: var(--accent);
  }
  .modern h1,
  .modern h2,
  .modern h3,
  .modern p,
  .modern ul,
  .modern ol {
    margin: 0;
  }
  .modern ul,
  .modern ol {
    padding: 0;
    list-style: none;
  }
  .modern .wrap {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }
  .modern .skip {
    position: absolute;
    left: -999px;
  }
  .modern .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 100;
    background: var(--bg);
    padding: 0.5rem 1rem;
  }

  /* Header */
  .modern .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .modern .top-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
  }
  .modern .brand {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .modern .nav {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .modern .nav ul {
    display: flex;
    gap: 0.25rem;
  }
  .modern .nav a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: 0.5rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .modern .nav a:hover,
  .modern .nav a:focus-visible {
    color: var(--text);
    background: var(--bg-alt);
  }
  .modern .term-link {
    white-space: nowrap;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .modern .term-link span {
    font-family: ui-monospace, Menlo, Consolas, monospace;
  }
  @media (max-width: 720px) {
    .modern .top-inner {
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      padding-top: 0.5rem;
    }
    .modern .brand {
      flex: 1;
    }
    .modern .nav {
      order: 3;
      flex-basis: 100%;
      margin: 0 -0.6rem 0.25rem;
    }
  }

  /* Hero */
  .modern .hero {
    padding: clamp(3rem, 10vw, 6.5rem) 0 clamp(2.5rem, 7vw, 4.5rem);
    background:
      radial-gradient(60rem 30rem at 85% -10%, var(--accent-soft), transparent 70%),
      var(--bg);
  }
  .modern .eyebrow {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .modern h1 {
    font-size: clamp(2.4rem, 7vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-top: 0.4rem;
  }
  .modern .role {
    font-size: clamp(1.15rem, 3vw, 1.5rem);
    color: var(--muted);
    margin-top: 0.4rem;
  }
  .modern .tagline {
    max-width: 40rem;
    margin-top: 1.1rem;
  }
  .modern .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  /* Bands */
  .modern .band {
    padding: clamp(2.5rem, 7vw, 4.5rem) 0;
    scroll-margin-top: 3.5rem;
  }
  .modern .band.alt {
    background: var(--bg-alt);
  }
  .modern h2 {
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    letter-spacing: -0.01em;
    margin-bottom: 1.2rem;
  }
  .modern h3 {
    font-size: 1.08rem;
  }

  /* Shared content pieces */
  .modern .pc-lead {
    font-size: 1.1rem;
    max-width: 46rem;
    margin-bottom: 1rem;
  }
  .modern .pc-about p + p {
    margin-top: 0.8rem;
  }
  .modern .pc-about p {
    max-width: 46rem;
  }
  .modern .pc-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .modern .pc-facts li {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 0.8rem 1rem;
  }
  .modern .pc-facts span {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .modern .pc-meta {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .modern .pc-timeline {
    border-left: 2px solid var(--line);
    margin-left: 0.4rem;
  }
  .modern .pc-role {
    position: relative;
    padding: 0 0 1.6rem 1.4rem;
  }
  .modern .pc-role::before {
    content: '';
    position: absolute;
    left: -0.45rem;
    top: 0.45rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg);
  }
  .modern .alt .pc-role::before {
    border-color: var(--bg-alt);
  }
  .modern .pc-role-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
  }
  .modern .pc-role ul,
  .modern .pc-bullets {
    list-style: disc;
    padding-left: 1.2rem;
    margin-top: 0.4rem;
  }
  .modern .pc-role li + li,
  .modern .pc-bullets li + li {
    margin-top: 0.2rem;
  }
  .modern .pc-sub {
    margin: 0.5rem 0 0.3rem;
  }
  .modern .pc-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1rem;
  }
  .modern .pc-cards-small {
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    margin-top: 1.2rem;
  }
  .modern .pc-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    padding: 1.2rem;
  }
  .modern .pc-featured {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }
  .modern .pc-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
  }
  .modern .pc-status {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }
  .modern .pc-active {
    color: #1f9d55;
  }
  .modern .pc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }
  .modern .pc-tag {
    font-size: 0.8rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text);
  }
  .modern .pc-cert {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .modern .pc-links {
    display: flex;
    gap: 1rem;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .modern .pc-skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.4rem 2rem;
  }
  .modern .pc-group h3 {
    margin-bottom: 0.5rem;
  }
  .modern .pc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: 1rem;
  }
  .modern .pc-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.1rem;
    border-radius: 0.6rem;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .modern .pc-btn:hover {
    border-color: var(--accent);
  }
  .modern .pc-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .modern .pc-primary:hover {
    filter: brightness(1.08);
  }
  .modern .pc-btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .modern .pc-form {
    display: grid;
    gap: 0.9rem;
    max-width: 44rem;
    margin-top: 1.5rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    padding: clamp(1rem, 3vw, 1.6rem);
  }
  .modern .pc-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.9rem;
  }
  .modern .pc-field {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .modern .pc-field input,
  .modern .pc-field select,
  .modern .pc-field textarea {
    font-weight: 400;
    font-size: 1rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
  }
  .modern .pc-field textarea {
    resize: vertical;
  }
  .modern .pc-field :focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: transparent;
  }
  .modern .pc-trap {
    position: absolute;
    left: -9999px;
  }
  .modern .pc-contact-list {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .modern .pc-contact-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }
  .modern .pc-contact-list span {
    min-width: 6rem;
    color: var(--muted);
  }
  .modern .pc-museum > p {
    max-width: 46rem;
  }

  /* Footer */
  .modern .foot {
    border-top: 1px solid var(--line);
    padding: 1.5rem 0 calc(1.5rem + env(safe-area-inset-bottom));
    color: var(--muted);
    font-size: 0.92rem;
  }
  .modern .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
  }
  .modern .looks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
  }
  .modern .looks-current {
    font-weight: 700;
    color: var(--text);
  }
</style>
