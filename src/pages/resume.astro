---
import Base from '@/layouts/Base.astro';
import { profile } from '@/data/profile';
import { resume } from '@/data/resume';
import { skills } from '@/data/skills';
import { withBase } from '@/utils';
---

<Base title="Resume" description={`Resume of ${profile.name}, ${profile.title}.`}>
  <div class="container page">
    <div class="toolbar">
      {
        profile.resumePdf && (
          <a class="btn" href={withBase(profile.resumePdf)} download>
            Download PDF
          </a>
        )
      }
      <button class="btn btn-secondary" type="button" onclick="window.print()">Print</button>
    </div>

    <article class="resume">
      <header>
        <h1>{profile.name}</h1>
        <p class="title">{profile.title}</p>
        <ul class="contact">
          <li>{profile.location}</li>
          {profile.email && <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>}
          {
            profile.links.map((link) => (
              <li>
                <a href={link.href}>{link.href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>
              </li>
            ))
          }
        </ul>
      </header>

      <section>
        <h2>Summary</h2>
        <p>{resume.summary}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {
          resume.experience.map((role) => (
            <div class="entry">
              <div class="entry-head">
                <h3>
                  {role.title}, <span class="org">{role.organization}</span>
                </h3>
                <span class="dates">
                  {role.start} – {role.end}
                </span>
              </div>
              {role.location && <p class="meta">{role.location}</p>}
              <ul>
                {role.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Skills</h2>
        <dl class="skills">
          {
            skills.map((group) => (
              <>
                <dt>{group.category}</dt>
                <dd>{group.items.join(', ')}</dd>
              </>
            ))
          }
        </dl>
      </section>

      {
        resume.certifications.length > 0 && (
          <section>
            <h2>Certifications</h2>
            <ul class="plain">
              {resume.certifications.map((c) => (
                <li class="entry-head">
                  <span>
                    {c.url ? <a href={c.url}>{c.name}</a> : c.name}, <span class="org">{c.issuer}</span>
                  </span>
                  <span class="dates">{c.year}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section>
        <h2>Education</h2>
        {
          resume.education.map((e) => (
            <div class="entry">
              <div class="entry-head">
                <h3>
                  {e.credential}, <span class="org">{e.institution}</span>
                </h3>
                <span class="dates">{e.year}</span>
              </div>
              {e.details && <p class="meta">{e.details}</p>}
            </div>
          ))
        }
      </section>
    </article>
  </div>
</Base>

<style>
  .page {
    max-width: 52rem;
    padding-block: 2.5rem 4rem;
  }
  .toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  button.btn {
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .resume {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 5vw, 3rem);
  }
  header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: 2rem;
  }
  .title {
    margin: 0.25rem 0 0.75rem;
    font-size: 1.125rem;
    color: var(--muted);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  section + section {
    margin-top: 1.75rem;
  }
  h2 {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  section > p {
    margin: 0;
  }
  .entry + .entry {
    margin-top: 1.25rem;
  }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 1rem;
  }
  h3 {
    font-size: 1.0625rem;
  }
  .org {
    font-weight: 400;
  }
  .dates,
  .meta {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .meta {
    margin: 0.1rem 0 0;
  }
  .entry ul {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }
  .entry li + li {
    margin-top: 0.25rem;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .plain li + li {
    margin-top: 0.4rem;
  }
  .skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1.25rem;
    margin: 0;
  }
  .skills dt {
    font-weight: 600;
  }
  .skills dd {
    margin: 0;
  }
  @media (max-width: 540px) {
    .skills {
      grid-template-columns: 1fr;
    }
    .skills dd {
      margin-bottom: 0.5rem;
    }
  }

  /* Print / "Save as PDF" produces a clean one-column resume. */
  @media print {
    :global(body) {
      background: #fff;
      color: #000;
      font-size: 10.5pt;
    }
    .page {
      padding: 0;
      max-width: none;
    }
    .toolbar {
      display: none;
    }
    .resume {
      border: 0;
      padding: 0;
      background: none;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    h2 {
      color: #000;
    }
    .entry {
      break-inside: avoid;
    }
  }
</style>
