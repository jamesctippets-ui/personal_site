---
// Standalone, printable resume. On screen it sits in a text-mode frame; in
// print it is plain black-on-white paper (see ResumeDoc's print styles).
import Base from '@/layouts/Base.astro';
import ResumeDoc from '@/components/ResumeDoc.astro';
import { profile } from '@/data/profile';
import { withBase } from '@/utils';
---

<Base title="Resume" description={`Resume of ${profile.name}, ${profile.title}.`}>
  <div class="page">
    <header class="bar">
      <span class="inv">PRINT RESUME.DOC</span>
      <nav>
        <a href={withBase('#resume')}>[ Back to JamesOS ]</a>
        <button type="button" id="print">[ Print / Save PDF ]</button>
        {
          profile.resumePdf && (
            <a href={withBase(profile.resumePdf)} download>
              [ Download PDF ]
            </a>
          )
        }
      </nav>
    </header>
    <div class="paper">
      <ResumeDoc />
    </div>
  </div>
</Base>

<script>
  document.getElementById('print')?.addEventListener('click', () => window.print());
</script>

<style>
  .page {
    max-width: 56rem;
    margin: 0 auto;
    padding: 1rem clamp(0.5rem, 3vw, 2rem) 2rem;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4em 1em;
    margin-bottom: 1rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1em;
  }
  #print {
    background: none;
    border: 0;
    padding: 0;
    color: var(--bright);
    text-decoration: underline;
    cursor: pointer;
  }
  #print:hover,
  #print:focus-visible {
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    outline: none;
  }
  .paper {
    background: #fbfaf6;
    text-shadow: none;
    padding: clamp(1.25rem, 5vw, 3.25rem);
    border: 3px double var(--fg);
  }

  @media print {
    :global(body) {
      background: #fff;
      text-shadow: none;
    }
    .page,
    .paper {
      padding: 0;
      margin: 0;
      max-width: none;
      border: 0;
      background: none;
    }
    .bar {
      display: none;
    }
  }
</style>
